{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push:*)",
      "Bash(sudo:*)",
      "Write(/traxgen-door/results/**)",
      "Write(/traxgen-door/claimed/**)",
      "Write(/traxgen-door/rejected/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.claude.json)"
    ],
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run python -m scripts.task_check:*)",
      "Bash(uv run python -m scripts.make_record_index:*)",
      "Bash(uv run python -m scripts.render_door request:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ]
  }
}
