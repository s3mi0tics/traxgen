# Project-specific
# Course fixtures ARE committed (they're test data from public API).
# Exclude only private scratch files:
tests/scratch/

# One-shot patch scripts that apply living-doc updates and aren't reused.
# Each session writes its own and runs it once; the diff is committed, not the script.
scripts/update_docs_*.py
# Screenshots from M6.c emulator automation runs.
# Generated at runtime; not test data.
screenshots/
# UI hierarchy dumps from uiautomator. One-off diagnostics.
window_dump_*.xml
# Session handoffs. workflow.md's handoff conventions say these stay local --
# they are artifacts, not canonical state, and a committed handoff goes stale
# the moment plan.md moves. That rule had no enforcement until 2026-08-23; this
# line is the cheap test for it (a convention without one decorates rather than
# constrains).
outputs/

